# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=skydeck
POSTGRES_PASSWORD=skydeck
POSTGRES_DB=skydeck
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Override to bypass decomposed vars (local dev shortcut).
# When set, this takes precedence over the POSTGRES_* vars above.
# IMPORTANT: Always use postgresql+psycopg2:// as the driver prefix.
# Bare postgresql:// or postgres:// will be auto-normalised, but
# being explicit avoids any ambiguity.
# DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5432/skydeck_dev

# ─── Application ───────────────────────────────────────────
APP_NAME=SkyDeck
DEBUG=true
BACKEND_PORT=8000

# ─── Security / JWT (required in production) ───────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-generate-a-64-byte-random-key
# Generate separately for encrypted message attachments/profile pictures:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
FILE_ENCRYPTION_MASTER_KEY=CHANGE-ME-generate-a-separate-64-byte-random-key
# Legacy/fallback name still supported:
# MESSAGE_ATTACHMENT_MASTER_KEY=CHANGE-ME-generate-a-separate-64-byte-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Connection Pool ───────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ─── Seed ─────────────────────────────────────────────────
RUN_SEED=true

# ─── Infra-only (used by deploy-assets/docker-compose.yml) ─
# PGADMIN_DEFAULT_EMAIL=admin@skydeck.local
# PGADMIN_DEFAULT_PASSWORD=admin
